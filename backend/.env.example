# LangChain provider integration (init_chat_model's model_provider).
# Valid values include: openai, anthropic, google_genai, bedrock, azure_ai.
# "openai" + a PROVIDER_BASE_URL targets any OpenAI-compatible endpoint (dev = NIM);
# for native providers set PROVIDER and leave PROVIDER_BASE_URL empty.
PROVIDER=openai

# Endpoint for OpenAI-compatible providers. Dev defaults target NVIDIA NIM.
# Leave empty for native providers (anthropic, google_genai, ...).
PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1
PROVIDER_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA NIM key, prefixed nvapi-. NEVER commit a real value.
PROVIDER_API_KEY=

# Guardrail pre-check model (reuses the provider base_url + key above).
# Defaults to the facilitator model; point it at a smaller/faster model
# (e.g. meta/llama-3.1-8b-instruct) once you've confirmed it on your key.
GUARDRAIL_MODEL=meta/llama-3.1-70b-instruct

# Next-action suggestions model (reuses the provider base_url + key above).
# Cheap, non-streaming call run after a step finishes — keep it fast. Defaults to
# the facilitator model; point it at a smaller/faster model once confirmed.
SUGGESTIONS_MODEL=meta/llama-3.1-70b-instruct

# Build-time branding, substituted into the system prompt.
BRAND_NAME=Acme
BRAND_VOICE=warm, plain-spoken, professional

# Explicit CORS allow-list (comma-separated). Never "*".
CORS_ORIGINS=http://localhost:5173
